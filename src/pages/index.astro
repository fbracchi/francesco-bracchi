---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import NewsletterForm from '../components/NewsletterForm.astro';
const jobs=[
 {period:'2004–2007',company:'Borsa Italiana',role:'Service Manager',text:'Responsabilità di service management in un contesto infrastrutturale e operativo legato ai mercati finanziari.'},
 {period:'dic. 2007 – mar. 2018',company:'Accenture',role:'Business Service Lead, Wealth & Asset Management',text:'Guida di servizi e iniziative per il Wealth & Asset Management, collegando competenze tecnologiche, processi e priorità di business.'},
 {period:'apr. 2018 – 2024',company:'Banca Profilo',role:'COO, IT / Operations / Servizi Generali',text:'Responsabilità sulle funzioni operative e tecnologiche, sul coordinamento dei servizi generali e sull’evoluzione dei processi.'},
 {period:'dal feb. 2024',company:'Cassa Lombarda',role:'COO, IT / Operations / Servizi Generali',text:'Responsabilità su IT, Operations e Servizi Generali, con attenzione alla trasformazione tecnologica e all’efficienza operativa.'}
];
const skills=['IT strategy','Trasformazione tecnologica','Compliance normativa','Cyber security','Automazione e RPA','AI applicata al banking','Budget e fornitori','Leadership di team'];
---
<BaseLayout title="Francesco Bracchi | COO, IT e Operations" description="Profilo professionale di Francesco Bracchi, COO nel settore bancario con esperienza in IT, Operations e trasformazione tecnologica.">
<Header />
<main id="contenuto">
<section class="hero" id="home"><div class="container hero-grid"><div><div class="eyebrow">IT · Operations · Trasformazione</div><h1>Francesco<br/>Bracchi</h1><p class="role">COO presso Cassa Lombarda</p><p class="positioning">Competenze tecnologiche e visione di business per guidare l’evoluzione operativa nel settore finanziario.</p><div class="hero-actions"><a class="button primary" href="#chi-sono">Scopri il profilo</a><a class="button secondary" href="https://www.linkedin.com/in/fbracchi/" target="_blank" rel="noopener noreferrer" aria-label="Profilo LinkedIn di Francesco Bracchi, si apre in una nuova scheda">LinkedIn ↗</a></div></div><div class="portrait"><img src="/images/francesco-bracchi.webp" width="1536" height="1920" alt="Ritratto professionale di Francesco Bracchi" fetchpriority="high" decoding="async" /></div></div></section>
<section class="section" id="chi-sono"><div class="container about-grid"><div><div class="eyebrow">Chi sono</div><h2 class="title">Tecnologia, operazioni e visione d’insieme</h2></div><div><p class="lead">COO con oltre 20 anni di esperienza nei servizi finanziari italiani, maturata tra Borsa Italiana, Accenture, Banca Profilo e Cassa Lombarda.</p><p>Laureato con lode in Informatica presso l’Università degli Studi di Milano, unisce una solida base tecnica alla capacità di leggere le priorità operative e strategiche del business bancario.</p><p class="fact">Il percorso professionale integra gestione dell’IT, Operations, Servizi Generali, trasformazione dei processi e governo di iniziative complesse.</p></div></div></section>
<section class="section alt" id="percorso"><div class="container"><div class="eyebrow">Percorso professionale</div><h2 class="title">Esperienze nei servizi finanziari</h2><div class="timeline">{jobs.map(job=><article class="timeline-item"><time>{job.period}</time><h3>{job.company}</h3><strong>{job.role}</strong><p>{job.text}</p></article>)}</div></div></section>
<section class="section" id="competenze"><div class="container"><div class="eyebrow">Competenze</div><h2 class="title">Aree di specializzazione</h2><p class="lead">Competenze costruite all’intersezione tra tecnologia, governo operativo e regolamentazione dei servizi finanziari.</p><div class="skills">{skills.map((skill,i)=><article class="skill"><div class="skill-icon" aria-hidden="true">{String(i+1).padStart(2,'0')}</div><h3>{skill}</h3></article>)}</div></div></section>
<section class="section alt"><div class="container"><div class="eyebrow">Fuori dall’ufficio</div><h2 class="title">Interessi</h2><div class="personal"><span class="tag">Lettura</span><span class="tag">Corsa</span><span class="tag">Value investing</span></div></div></section>
<section class="section" id="contatti"><div class="container contact-grid"><div><div class="eyebrow">Contatti</div><h2 class="title">Restiamo in contatto</h2><p class="lead">Per contatti professionali e aggiornamenti, il canale principale è LinkedIn.</p><a class="button primary" href="https://www.linkedin.com/in/fbracchi/" target="_blank" rel="noopener noreferrer">Vai a LinkedIn ↗</a></div><NewsletterForm /></div></section>
</main><Footer />
</BaseLayout>
